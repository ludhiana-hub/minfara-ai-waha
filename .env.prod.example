APP_NAME="Deutsch Lernen mit Fara"
APP_ENV=production
APP_KEY=                            # jalankan: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://YOUR_DOMAIN         # ganti dengan domain kamu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                     # production: error saja

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql                       # nama service di docker-compose
DB_PORT=3306
DB_DATABASE=minfara_bot
DB_USERNAME=minfara
DB_PASSWORD=GANTI_PASSWORD_KUAT     # samakan dengan DB_PASSWORD di docker-compose

# ── Session & Cache ────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── WAHA ──────────────────────────────────────────────────────────────────────
WAHA_URL=http://waha:3000           # nama service di docker-compose
WAHA_SESSION=default
WAHA_API_KEY=GANTI_WAHA_API_KEY

# ── AI Providers ──────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-14b:free

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ── Mail (opsional) ───────────────────────────────────────────────────────────
MAIL_MAILER=log
